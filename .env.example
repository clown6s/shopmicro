# ==============================================
# ShopMicro 环境配置
# ==============================================
# 开发环境使用 localhost，生产环境替换为实际地址
# 不要提交包含真实生产地址的 .env 文件到版本控制！

# Redis 配置
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Etcd 配置（逗号分隔多个地址）
ETCD_ADDRS=localhost:2379

# JWT 密钥（dev: 至少32字符, prod: 至少64字符）
JWT_SECRET=your-jwt-secret-here-change-in-production

# OpenTelemetry 配置（可选）
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

# HashiCorp Vault（可选）
VAULT_ADDRESS=
VAULT_TOKEN=

# 服务器地址（可选，用于容器环境端口绑定）
SERVER_ADDR=:8080

# Proto 文件基础路径（可选）
PROTO_BASE=../
