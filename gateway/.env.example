# ==========================================
# 安全警告：此文件包含模板配置，不要放入真实密钥！
# 实际部署时：
#   1. 使用 HashiCorp Vault（推荐）
#   2. 或使用环境变量（export JWT_SECRET=...）
#   3. .env 文件已在 .gitignore 中，不会被提交
# ==========================================

# MySQL
MYSQL_DSN=root:your_password@tcp(your-server-ip:3306)/shop_micro?charset=utf8mb4&parseTime=True&loc=Local

# Redis
REDIS_ADDR=your-server-ip:6379
REDIS_PASSWORD=your_redis_password

# JWT (至少32字符，生产环境必须使用强密钥)
JWT_SECRET=your-jwt-secret-key-at-least-32-chars

# OTEL
OTEL_EXPORTER_OTLP_ENDPOINT=your-server-ip:4317
