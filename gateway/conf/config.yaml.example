server:
  addr: ":7000"

redis:
  addr: "127.0.0.1:6379"
  password: "changeme"        # Redis 密码
  db: 0

jwt:
  secret: "changeme"          # JWT 签名密钥（至少32位随机字符串）
  issuer: "shopmicro"

cors:
  allowOrigins:
    - "http://localhost:3000"
    - "http://127.0.0.1:3000"
  allowCredentials: true

protoBase: "../"

etcd:
  addrs:
    - "127.0.0.1:2379"

mode: "dev"                   # dev / staging / prod

otel:
  endpoint: ""                # OpenTelemetry collector 地址，空则禁用
  sampleRate: 0               # 采样率 0~1

rateLimit:
  limit: 1000000
  windowSec: 60
  endpoints:
    user/Login:
      limit: 5
      windowSec: 60
