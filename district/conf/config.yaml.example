server:
  addr: ":6000"

registryIP: "127.0.0.1"       # 注册到 etcd 的 IP，本地开发填 127.0.0.1

mysql:
  dsn: "root:changeme@tcp(127.0.0.1:3306)/shop_micro?charset=utf8mb4&parseTime=True&loc=Local"

etcd:
  addrs:
    - "127.0.0.1:2379"

mode: "dev"                   # dev / staging / prod

amap:
  key: "changeme"             # 高德地图 API Key
  timeout: 120
